# -*- mode: python ; coding: utf-8 -*-
"""PyInstaller recipe for the DeskGuardian single-file executable."""

from pathlib import Path

from PyInstaller.utils.hooks import collect_all, collect_submodules


project_dir = Path(SPEC).resolve().parent

datas = []
binaries = []
hiddenimports = [
    "flask",
    "werkzeug",
    "jinja2",
    "markupsafe",
    "click",
]

# Flask cannot discover these folders once the application is unpacked into
# PyInstaller's temporary directory unless they are explicitly bundled.
for directory in ("templates", "static"):
    source = project_dir / directory
    if source.is_dir():
        datas.append((str(source), directory))

# Bundle public notices next to the application resources. Runtime configuration
# is created in the user's data directory by config.py, never in _MEIPASS.
for filename in ("LICENSE", "THIRD_PARTY_NOTICES.md", "README.md"): 
    source = project_dir / filename
    if source.is_file():
        datas.append((str(source), "."))

# These packages contain locale tables, platform backends, or dynamically
# imported modules that static analysis does not reliably find.
for package in ("dateparser", "plyer"):
    package_datas, package_binaries, package_hiddenimports = collect_all(package)
    datas += package_datas
    binaries += package_binaries
    hiddenimports += package_hiddenimports
    hiddenimports += collect_submodules(package)

# Preserve order while removing duplicates generated by hook combinations.
hiddenimports = list(dict.fromkeys(hiddenimports))


a = Analysis(
    [str(project_dir / "main.py")],
    pathex=[str(project_dir)],
    binaries=binaries,
    datas=datas,
    hiddenimports=hiddenimports,
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=[
        "tkinter",
        "matplotlib",
        "pandas",
        "numpy",
        "scipy",
    ],
    noarchive=False,
    optimize=0,
)

pyz = PYZ(a.pure)

exe = EXE(
    pyz,
    a.scripts,
    a.binaries,
    a.datas,
    [],
    name="deskguardian",
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    # PyInstaller automatically skips compression when UPX is unavailable.
    upx=True,
    upx_exclude=[],
    runtime_tmpdir=None,
    console=True,
    disable_windowed_traceback=False,
    argv_emulation=False,
    target_arch=None,
    codesign_identity=None,
    entitlements_file=None,
)
